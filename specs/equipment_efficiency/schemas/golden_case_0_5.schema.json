{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equipeffi.local/schema/golden-case-0.5.json",
  "title": "EquipEffi GB 19762-2025 Unified Approved Golden Record 0.5",
  "description": "Phase 3 unified approved Golden record for GB 19762-2025 centrifugal pumps. Generalizes the 0.4 approved-record contract to both pump_water and pump_chemical without migrating, rewriting or re-approving the existing 18 water golden-case-0.4 records. Provenance is tagged: CANDIDATE_DERIVED records resolve to a versioned candidate set, while OWNER_DEFINED records record named-owner approval plus standard/Canonical evidence and deliberately carry no candidate file/line.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_schema_version",
    "case_id",
    "case_status",
    "approval_status",
    "review_status",
    "device_type",
    "profile_id",
    "numeric_contract_id",
    "evaluation_layer",
    "raw_inputs",
    "expected_result",
    "expected_calculation_trace",
    "source_sidecar",
    "review_owner",
    "reviewed_at",
    "approved_at",
    "approval_basis",
    "known_limits",
    "provenance",
    "review_flags"
  ],
  "properties": {
    "case_schema_version": {
      "const": "golden-case-0.5"
    },
    "case_id": {
      "type": "string",
      "pattern": "^GC-PUMP-V5-(WATER|CHEMICAL)-[A-Z0-9-]+$"
    },
    "case_status": {
      "const": "APPROVED"
    },
    "approval_status": {
      "const": "APPROVED"
    },
    "review_status": {
      "const": "APPROVED"
    },
    "device_type": {
      "const": "centrifugal_pump"
    },
    "profile_id": {
      "enum": [
        "pump_water",
        "pump_chemical"
      ]
    },
    "numeric_contract_id": {
      "const": "PUMP_NUMERIC_AND_DECISION_CONTRACT_V2"
    },
    "evaluation_layer": {
      "enum": [
        "APPLICATION_E2E",
        "PROFILE_EVALUATOR_TECHNICAL"
      ]
    },
    "raw_inputs": {
      "$ref": "#/$defs/raw_inputs"
    },
    "expected_result": {
      "$ref": "#/$defs/expected_result"
    },
    "expected_calculation_trace": {
      "$ref": "#/$defs/calculation_trace"
    },
    "source_sidecar": {
      "$ref": "#/$defs/source_sidecar"
    },
    "historical_origin_id": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_owner": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*",
      "description": "Named human reviewer; placeholders rejected by semantic validator."
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "known_limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "review_flags": {
      "const": []
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluation_layer": {
            "const": "APPLICATION_E2E"
          }
        },
        "required": [
          "evaluation_layer"
        ]
      },
      "then": {
        "properties": {
          "expected_result": {
            "properties": {
              "support_status": {
                "enum": [
                  "SUPPORTED",
                  "NOT_IN_RELEASE_SCOPE"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "expected_result": {
            "properties": {
              "support_status": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_id": {
            "pattern": "^GC-PUMP-V5-WATER-"
          }
        },
        "required": [
          "case_id"
        ]
      },
      "then": {
        "properties": {
          "profile_id": {
            "const": "pump_water"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_id": {
            "pattern": "^GC-PUMP-V5-CHEMICAL-"
          }
        },
        "required": [
          "case_id"
        ]
      },
      "then": {
        "properties": {
          "profile_id": {
            "const": "pump_chemical"
          }
        }
      }
    }
  ],
  "$defs": {
    "raw_text_or_null": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Keep the exact source text, including invalid values for negative cases. The evaluator validates accepted formats; schema validation must not rewrite or fill this value."
    },
    "raw_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_type",
        "suction",
        "stages",
        "QBEP",
        "HBEP",
        "speed",
        "efficiency",
        "input_basis",
        "measurement_point"
      ],
      "properties": {
        "product_type": {
          "$ref": "#/$defs/raw_text_or_null",
          "description": "GB 19762-2025 product category; valid values are profile-specific Canonical types. Null/unknown text remains explicit and resolves to UNRESOLVED."
        },
        "suction": {
          "$ref": "#/$defs/raw_text_or_null",
          "description": "Valid values: 单吸 or 双吸. Other text is preserved for INVALID_INPUT cases."
        },
        "stages": {
          "$ref": "#/$defs/raw_text_or_null",
          "description": "Valid value is a positive integer text. Single-stage profile types require 1; multistage types require at least 2. Null and malformed strings are explicit negative inputs."
        },
        "QBEP": {
          "$ref": "#/$defs/raw_text_or_null",
          "description": "Total BEP flow in m3/h, before suction conversion."
        },
        "HBEP": {
          "$ref": "#/$defs/raw_text_or_null",
          "description": "Total BEP head in m, before dividing by stages."
        },
        "speed": {
          "$ref": "#/$defs/raw_text_or_null",
          "description": "BEP speed in r/min."
        },
        "efficiency": {
          "$ref": "#/$defs/raw_text_or_null",
          "description": "BEP pump efficiency as percent points, e.g. 80 means 80%."
        },
        "input_basis": {
          "const": "STANDARD_BEP"
        },
        "measurement_point": {
          "const": "BEP"
        }
      }
    },
    "expected_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_status",
        "category_status",
        "evaluation_status",
        "ui_conclusion",
        "grade",
        "issue_codes"
      ],
      "properties": {
        "support_status": {
          "anyOf": [
            {
              "enum": [
                "SUPPORTED",
                "NOT_IN_RELEASE_SCOPE"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "category_status": {
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE",
            "UNRESOLVED"
          ]
        },
        "evaluation_status": {
          "anyOf": [
            {
              "enum": [
                "SUCCESS",
                "INSUFFICIENT_DATA",
                "INVALID_INPUT",
                "OUT_OF_STANDARD_SCOPE"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "ui_conclusion": {
          "enum": [
            "1级",
            "2级",
            "3级",
            "未达标",
            "无法判定",
            "不适用",
            "当前版本未支持"
          ]
        },
        "grade": {
          "anyOf": [
            {
              "enum": [
                "1",
                "2",
                "3",
                "BELOW_MINIMUM"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "issue_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evaluation_status": {
                "const": "SUCCESS"
              }
            },
            "required": [
              "evaluation_status"
            ]
          },
          "then": {
            "properties": {
              "grade": {
                "enum": [
                  "1",
                  "2",
                  "3",
                  "BELOW_MINIMUM"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "grade": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "calculation_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_basis",
        "derived",
        "matched_rule_id",
        "grade_thresholds_internal"
      ],
      "properties": {
        "execution_basis": {
          "enum": [
            "BUSINESS_DRAFT",
            "TECHNICAL_DIAGNOSTIC_ONLY"
          ]
        },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "suction_factor": {
              "type": [
                "string",
                "null"
              ]
            },
            "stage_count": {
              "type": [
                "string",
                "null"
              ]
            },
            "q_for_ns_m3s": {
              "type": [
                "string",
                "null"
              ]
            },
            "h_for_ns_m": {
              "type": [
                "string",
                "null"
              ]
            },
            "ns_raw": {
              "type": [
                "string",
                "null"
              ]
            },
            "eta_b": {
              "type": [
                "string",
                "null"
              ]
            },
            "delta_eta": {
              "type": [
                "string",
                "null"
              ]
            },
            "eta_0": {
              "type": [
                "string",
                "null"
              ]
            },
            "output_power_kw": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "matched_rule_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "grade_thresholds_internal": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3
        }
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "artifact_kind",
        "artifact_path",
        "artifact_sha256",
        "clause_or_table",
        "evidence_role"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_kind": {
          "enum": [
            "REPOSITORY_FILE",
            "EXTERNAL_FILE"
          ]
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1,
          "description": "REPOSITORY_FILE uses a repository-relative path. EXTERNAL_FILE uses the relative_path registered for source_id in evidence_registry.json; resolve it under --external-evidence-root or EQUIPEFFI_EXTERNAL_EVIDENCE_ROOT. Never store a machine-specific absolute path in a versioned Golden or review record."
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$",
          "description": "SHA-256 for repository text files is computed after canonical CRLF-to-LF normalization so pins are stable across Windows checkout settings; external and non-text files use raw-byte SHA-256."
        },
        "clause_or_table": {
          "type": "string",
          "minLength": 1
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stable_data_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_role": {
          "enum": [
            "STANDARD",
            "CANONICAL_PACK",
            "CURRENT_IMPLEMENTATION",
            "LEGACY_DIAGNOSTIC"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "source_sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_references"
      ],
      "properties": {
        "source_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_reference"
          },
          "minItems": 1
        }
      }
    },
    "provenance": {
      "description": "Tagged provenance. CANDIDATE_DERIVED requires the versioned candidate locator; OWNER_DEFINED records named-owner approval without fabricating a candidate file/line.",
      "oneOf": [
        {
          "$ref": "#/$defs/provenance_candidate_derived"
        },
        {
          "$ref": "#/$defs/provenance_owner_defined"
        }
      ]
    },
    "provenance_candidate_derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_kind",
        "source_candidate_case_id",
        "source_candidate_schema_version",
        "source_candidate_file",
        "source_candidate_line",
        "source_candidate_sha256",
        "source_baseline_sha"
      ],
      "properties": {
        "provenance_kind": {
          "const": "CANDIDATE_DERIVED"
        },
        "source_candidate_case_id": {
          "type": "string",
          "pattern": "^GC-PUMP-V3-[A-Z0-9-]+$"
        },
        "source_candidate_schema_version": {
          "type": "string",
          "pattern": "^golden-case-[0-9]+\\.[0-9]+$"
        },
        "source_candidate_file": {
          "type": "string",
          "minLength": 1,
          "description": "Must be an allowlisted candidate source registered in pump_candidate_source_registry_v0_1.json; the semantic validator resolves it through the registry instead of hardcoding one file."
        },
        "source_candidate_line": {
          "type": "integer",
          "minimum": 1
        },
        "source_candidate_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$",
          "description": "SHA-256 of canonical UTF-8 JSON for the parsed source candidate object (sorted keys, compact separators, no trailing newline)."
        },
        "source_baseline_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "provenance_owner_defined": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_kind",
        "owner_approval_evidence_id",
        "owner_defined_case_ref",
        "standard_evidence",
        "canonical_evidence"
      ],
      "properties": {
        "provenance_kind": {
          "const": "OWNER_DEFINED"
        },
        "owner_approval_evidence_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifies the product-owner approval evidence record that covers this case."
        },
        "owner_defined_case_ref": {
          "type": "string",
          "pattern": "^C[0-9]+$",
          "description": "Owner case label (for example C9) from the approval evidence; not a candidate-derived id."
        },
        "standard_evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Standard clause/table/formula providing the business basis for this owner-defined case."
        },
        "canonical_evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical stable data id(s) backing the expected thresholds for this case."
        }
      }
    }
  }
}
