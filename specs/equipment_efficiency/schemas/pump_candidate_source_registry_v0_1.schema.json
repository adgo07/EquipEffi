{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equipeffi.local/schema/pump-candidate-source-registry-0.1.json",
  "title": "EquipEffi versioned pump candidate source registry 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "candidate_sources", "replacements"],
  "properties": {
    "registry_version": { "const": "pump-candidate-source-registry-0.1" },
    "candidate_sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_set_version",
          "source_candidate_schema_version",
          "source_candidate_file",
          "source_baseline_sha",
          "source_file_sha256",
          "record_count"
        ],
        "properties": {
          "candidate_set_version": {
            "enum": ["pump-water-e2e-v0.3", "pump-water-replacement-v0.1"]
          },
          "source_candidate_schema_version": {
            "pattern": "^golden-case-[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "source_candidate_file": {
            "enum": [
              "specs/equipment_efficiency/golden/pump_e2e_v0_3_candidates.jsonl",
              "specs/equipment_efficiency/golden/pump_water_replacement_candidates_v0_1.jsonl"
            ]
          },
          "source_baseline_sha": {
            "pattern": "^[a-f0-9]{40}$",
            "type": "string"
          },
          "source_file_sha256": {
            "pattern": "^[A-Fa-f0-9]{64}$",
            "type": "string"
          },
          "record_count": { "minimum": 1, "type": "integer" }
        }
      }
    },
    "replacements": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_candidate_case_id", "replacement_candidate_case_id"],
        "properties": {
          "source_candidate_case_id": {
            "pattern": "^GC-PUMP-V3-WATER-[A-Z0-9-]+$",
            "type": "string"
          },
          "replacement_candidate_case_id": {
            "pattern": "^GC-PUMP-V3-R1-WATER-[A-Z0-9-]+$",
            "type": "string"
          }
        }
      }
    }
  }
}
